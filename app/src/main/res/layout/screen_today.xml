<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="22dp"
        android:paddingBottom="116dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/avatar"
                    android:layout_width="52dp"
                    android:layout_height="36dp"
                    android:background="@drawable/circle_soft"
                    android:gravity="center"
                    android:text="GH"
                    android:textColor="@color/primary_dark"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pageTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="专注"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/streak"
                    android:layout_width="52dp"
                    android:layout_height="34dp"
                    android:background="@drawable/circle_surface"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/primary_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/dateScroll"
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:layout_marginTop="18dp"
                android:scrollbars="none"
                android:overScrollMode="never">
                <LinearLayout
                    android:id="@+id/dateStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:background="@drawable/card"
                android:elevation="2dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="今日练习"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/todayMinutes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0 分钟"
                    android:textColor="@color/ink"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/todayGoal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="目标 90 分钟 · 完成 0%"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/todayProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="14dp"
                    android:max="100"
                    android:progress="0" />
            </LinearLayout>

            <TextView
                android:id="@+id/todayHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="练习内容"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/todayList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/fabTimer"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="112dp"
        android:background="@drawable/fab"
        android:elevation="8dp"
        android:gravity="center"
        android:text="计时"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</FrameLayout>
