<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/timer_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="88dp"
        android:paddingBottom="42dp">

        <TextView
            android:id="@+id/timerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="正在练习"
            android:textColor="#DDFEFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <TextView
            android:id="@+id/timerSubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="保持专注 · 完成这一组"
            android:textColor="#9FD4D8"
            android:textSize="13sp"
            android:layout_marginTop="10dp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="78dp" />

        <LinearLayout
            android:id="@+id/flipTimerGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="142dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/flip_digit_shadow"
                android:paddingBottom="4dp">
                <TextView
                    android:id="@+id/digitMinTens"
                    android:layout_width="match_parent"
                    android:layout_height="138dp"
                    android:gravity="center"
                    android:background="@drawable/flip_digit_card"
                    android:text="2"
                    android:textColor="#163237"
                    android:textSize="78sp"
                    android:textStyle="bold" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center_vertical"
                    android:background="#E2EEEE" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="142dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/flip_digit_shadow"
                android:paddingBottom="4dp">
                <TextView
                    android:id="@+id/digitMinOnes"
                    android:layout_width="match_parent"
                    android:layout_height="138dp"
                    android:gravity="center"
                    android:background="@drawable/flip_digit_card"
                    android:text="5"
                    android:textColor="#163237"
                    android:textSize="78sp"
                    android:textStyle="bold" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center_vertical"
                    android:background="#E2EEEE" />
            </FrameLayout>

            <TextView
                android:layout_width="24dp"
                android:layout_height="142dp"
                android:gravity="center"
                android:text=":"
                android:textColor="#EAFDFE"
                android:textSize="54sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="142dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/flip_digit_shadow"
                android:paddingBottom="4dp">
                <TextView
                    android:id="@+id/digitSecTens"
                    android:layout_width="match_parent"
                    android:layout_height="138dp"
                    android:gravity="center"
                    android:background="@drawable/flip_digit_card"
                    android:text="0"
                    android:textColor="#163237"
                    android:textSize="78sp"
                    android:textStyle="bold" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center_vertical"
                    android:background="#E2EEEE" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="142dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/flip_digit_shadow"
                android:paddingBottom="4dp">
                <TextView
                    android:id="@+id/digitSecOnes"
                    android:layout_width="match_parent"
                    android:layout_height="138dp"
                    android:gravity="center"
                    android:background="@drawable/flip_digit_card"
                    android:text="0"
                    android:textColor="#163237"
                    android:textSize="78sp"
                    android:textStyle="bold" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center_vertical"
                    android:background="#E2EEEE" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="25:00"
            android:textColor="#B7E6EA"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/timerHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="倒计时期间无法返回，结束后自动记录时长"
            android:textColor="#A2D6DA"
            android:textSize="13sp"
            android:layout_marginTop="10dp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/pauseButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:background="@drawable/timer_button_ghost"
                android:text="暂停"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/endButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:background="@drawable/timer_button_primary"
                android:text="结束"
                android:textColor="#163237"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
