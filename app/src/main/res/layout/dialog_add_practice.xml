<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="添加练习内容" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/ink"/>
        <EditText android:id="@+id/inputName" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:background="@drawable/input" android:hint="练习名称，如 C大调音阶"/>
        <EditText android:id="@+id/inputType" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/input" android:hint="练习类型，如 音阶练习"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/minusTime" android:layout_width="54dp" android:layout_height="44dp" android:text="-"/>
            <TextView android:id="@+id/inputMinutes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="15 分钟" android:textSize="18sp" android:textStyle="bold"/>
            <Button android:id="@+id/plusTime" android:layout_width="54dp" android:layout_height="44dp" android:text="+"/>
        </LinearLayout>
        <EditText android:id="@+id/inputNote" android:layout_width="match_parent" android:layout_height="90dp" android:layout_marginTop="12dp" android:background="@drawable/input" android:gravity="top" android:hint="备注说明"/>
    </LinearLayout>
</ScrollView>
